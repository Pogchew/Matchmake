<script>
const MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
const DAYS_FULL = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
// Scrim dots on specific days (1-based)
const SCRIM_DAYS = [6,9,14,18,19,24];
let current = new Date(2024, 9, 18); // Oct 18 2024
let selected = 18;

function renderCalendar() {
  const year = current.getFullYear();
  const month = current.getMonth();
  document.getElementById('monthLabel').textContent = MONTHS[month];

  const firstDay = new Date(year, month, 1).getDay();
  const daysInMonth = new Date(year, month + 1, 0).getDate();
  const prevDays = new Date(year, month, 0).getDate();

  let html = '';

  // Leading blanks from prev month
  for (let i = firstDay - 1; i >= 0; i--) {
    html += `<div class="py-2 text-outline-variant cursor-default">${prevDays - i}</div>`;
  }

  // Current month days
  for (let d = 1; d <= daysInMonth; d++) {
    const hasScrim = SCRIM_DAYS.includes(d);
    const isSelected = d === selected;
    const dot = hasScrim ? `<div class="w-1 h-1 ${isSelected ? 'bg-on-primary' : 'bg-outline'} rounded-full absolute bottom-1"></div>` : '';
    if (isSelected) {
      html += `<div onclick="selectDay(${d})" class="py-2 cursor-pointer bg-primary text-on-primary rounded-lg flex flex-col items-center relative shadow-sm">
        <span class="font-label-bold">${d}</span>${dot}
      </div>`;
    } else {
      html += `<div onclick="selectDay(${d})" class="py-2 cursor-pointer hover:bg-surface-container rounded-lg flex flex-col items-center relative">
        <span>${d}</span>${dot}
      </div>`;
    }
  }

  // Trailing blanks
  const total = firstDay + daysInMonth;
  const trailing = total % 7 === 0 ? 0 : 7 - (total % 7);
  for (let i = 1; i <= trailing; i++) {
    html += `<div class="py-2 text-outline-variant cursor-default">${i}</div>`;
  }

  document.getElementById('calGrid').innerHTML = html;

  // Update day label
  const selDate = new Date(year, month, selected);
  document.getElementById('dayLabel').textContent =
    `${DAYS_FULL[selDate.getDay()]}, ${MONTHS[month].slice(0,3)} ${selected}`;
}

function selectDay(d) {
  selected = d;
  renderCalendar();
}

function changeMonth(dir) {
  current.setMonth(current.getMonth() + dir);
  selected = 1;
  renderCalendar();
}

renderCalendar();
</script>
